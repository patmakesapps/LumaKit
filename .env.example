# ---------------------------------------------------------------------------
# Model provider. LumaKit runs on local Ollama (default, private) or a hosted
# API — Anthropic (Claude), OpenAI (GPT), or xAI (Grok).
#   LLM_PROVIDER: ollama | anthropic | openai | xai   (default: ollama)
#   LLM_MODEL / LLM_FALLBACK_MODEL: model IDs for the chosen provider
#   LLM_API_KEY: API key for hosted providers (ANTHROPIC_API_KEY /
#                OPENAI_API_KEY / XAI_API_KEY also work)
#   LLM_BASE_URL: optional endpoint override
# Examples:
#   LLM_PROVIDER="anthropic"  LLM_MODEL="claude-opus-4-8"
#   LLM_PROVIDER="openai"     LLM_MODEL="gpt-5.2"
#   LLM_PROVIDER="xai"        LLM_MODEL="grok-4"
# LLM_PROVIDER="ollama"
# LLM_MODEL=""
# LLM_FALLBACK_MODEL=""
# LLM_API_KEY=""
# LLM_BASE_URL=""
# ---------------------------------------------------------------------------

# Ollama-specific model settings (aliases for provider=ollama; still honored).
# Recommended:
# - if your Ollama setup exposes strong cloud-backed models, use one for the
#   best first-run tool quality
# - if you want the fully local/private path, point this at a local model
OLLAMA_MODEL="your-model-here"

# Optional fallback if the primary is unavailable or overloaded
OLLAMA_FALLBACK_MODEL=""

# Optional local model that the Telegram owner can toggle on with `/model local on`
OLLAMA_LOCAL_MODEL=""

# Examples of the kind of models that work well with this repo:
# OLLAMA_MODEL="glm-5:cloud"
# OLLAMA_MODEL="qwen3"
# OLLAMA_MODEL="llama3.3"
# OLLAMA_FALLBACK_MODEL="gemma3:4b"

# Web server bind host. Defaults to 127.0.0.1 (local-only). Setting this to
# 0.0.0.0 exposes the UI to your network — every request still requires the
# per-install session token stored in ~/.lumakit/web_session_token, and you
# must list remote hostnames in LUMAKIT_ALLOWED_ORIGINS for browser access.
# LUMAKIT_BIND_HOST="127.0.0.1"
# LUMAKIT_ALLOWED_ORIGINS=""

# File tools are sandboxed to the active workspace. To let them touch extra
# directories, list absolute paths here separated by your OS path separator
# (";" on Windows, ":" elsewhere). Secrets files (.env, config.env,
# ~/.lumakit/**, .git/config) stay blocked regardless.
# LUMAKIT_ALLOW_PATHS=""

# Autonomous tasks write a small round-by-round trace to ~/.lumakit/traces/
# (tool calls, timings, result sizes — no full payloads). Set to 0 to disable;
# traces older than the retention window are pruned when the backend starts.
# LUMAKIT_TASK_TRACES=1
# LUMAKIT_TRACE_RETENTION_DAYS=30

# Serp API for premium web search capabilities.
SERPAPI_KEY="Your API key here"

# Telegram bot (create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN="Your bot token here"
# Comma-separated chat IDs — first is the owner/admin. Only the owner can use
# shell/python/file-write/git tools; other users default to the 'trusted'
# role (chat, read, search). Owner can adjust with /role (trusted|limited).
TELEGRAM_ALLOWED_IDS="your_id,spouse_id,kid_id"

# Optional local Telegram speech settings.
# whisper.cpp handles STT locally, and edge-tts handles outgoing voice replies.
LUMIKIT_WHISPER_DIR=".vendor/whisper.cpp"
LUMIKIT_WHISPER_BIN=".vendor/whisper.cpp/build/bin/whisper-cli"
LUMIKIT_WHISPER_MODEL=".vendor/whisper.cpp/models/ggml-base.en.bin"
LUMIKIT_EDGE_TTS_PYTHON=".venv/bin/python"
LUMIKIT_TTS_VOICE="en-US-AvaNeural"
LUMIKIT_TTS_FORMAT="mp3"

# LumaBot hardware daemon (local when LumaKit runs on the robot).
LUMABOT_URL="http://127.0.0.1:8971"
LUMABOT_ACTIVITY_INDICATOR="0"

# Lumi's own email account (Gmail recommended — use an App Password)
# Generate one at https://myaccount.google.com/apppasswords
# Email tools are owner-only (only the first TELEGRAM_ALLOWED_IDS can trigger them)
LUMI_EMAIL_ADDRESS=
LUMI_EMAIL_PASSWORD=
LUMI_EMAIL_SMTP_HOST="smtp.gmail.com"
LUMI_EMAIL_SMTP_PORT="465"
LUMI_EMAIL_IMAP_HOST="imap.gmail.com"
LUMI_EMAIL_IMAP_PORT="993"
# Signature appended to every outbound email
LUMI_EMAIL_SIGNATURE="Lumi - official LumaKit agent"
# Max emails Lumi can send per rolling 1-hour window (safety cap)
LUMI_EMAIL_MAX_PER_HOUR="10"
